{
  "name": "fidret",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.1.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --port 8765",
    "typecheck": "node scripts/astro.mjs check",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1 --port 8765",
    "test": "node --test --test-isolation=none tests/*.test.ts tests/*.test.mjs",
    "check": "sh scripts/check_deployment.sh",
    "lab:new": "node scripts/lab.mjs new",
    "runtime:check": "node --test --test-isolation=none tests/node-runtime.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "astro": "7.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
