---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Byline from '../../components/Byline.astro';
import PublicationDate from '../../components/PublicationDate.astro';
import { authorRegistry, kindLabels } from '../../lib/lab-schema';
import { getPublishedPieces } from '../../lib/lab';
import '../../styles/knowledge.css';

export const getStaticPaths = (() => Object.entries(authorRegistry).map(([id, person]) => ({ params: { author: id }, props: { id, person } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { id, person } = Astro.props;
const pieces = (await getPublishedPieces()).filter(piece => piece.data.authors.includes(id));
---
<SiteLayout title={`${person.name} — Fidret Lab`} description={`Published Fidret Lab pieces credited to ${person.name}. Authorship is recorded on each piece.`} canonical={`https://fidret.com/people/${id}/`} variant="lab">
  <main id="main" class="knowledge-page person-page">
    <header class="person-hero shell"><a class="text-link" href="/lab/">Fidret Lab</a><p class="section-context">Contributor</p><h1>{person.name}</h1><p class="knowledge-lead">The work, with its byline.</p><p>This page brings together published Fidret Lab pieces that credit {person.name}. Each piece records its actual authors, publication date and scope.</p></header>

    <section class="person-pieces shell" aria-labelledby="pieces-title"><div class="knowledge-section-heading"><h2 id="pieces-title">Published pieces</h2><p>{pieces.length === 0 ? 'No published pieces are credited here yet.' : pieces.length === 1 ? 'One published piece.' : `${pieces.length} published pieces.`}</p></div>
      {pieces.length > 0 ? <div class="knowledge-piece-list">{pieces.map(piece => <article class="knowledge-piece"><div class="knowledge-piece-meta"><span>{kindLabels[piece.data.kind]}</span><PublicationDate value={piece.data.published} /></div><div><h3><a href={`/lab/${piece.data.slug}/`}>{piece.data.title}</a></h3><p>{piece.data.summary}</p><p class="knowledge-piece-credit">By <Byline authors={piece.data.authors} /></p></div></article>)}</div> : <div class="person-empty"><h3>A shared Lab.<br />Specific credit.</h3><p>Each piece carries its own byline. Work credited to {person.name} appears here as it is published.</p><a class="text-link" href="/lab/">Explore the Lab</a></div>}
    </section>
    <aside class="person-context shell"><h2>Part of a company<br />taking shape.</h2><div><p>Fidret is developing its first practice in Physical AI. Its Lab shares questions, methods, takeaways and limits as the work grows.</p><a class="text-link" href="/project/">Inside Fidret</a></div></aside>
  </main>
</SiteLayout>
