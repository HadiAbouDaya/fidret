---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Byline from '../../components/Byline.astro';
import PublicationDate from '../../components/PublicationDate.astro';
import { authorRegistry, kindLabels } from '../../lib/lab-schema';
import { getPublishedPieces } from '../../lib/lab';
import '../../styles/knowledge.css';
import '../../styles/visitor.css';
import ProjectInvitation from '../../components/ProjectInvitation.astro';
import {hadiProfile} from '../../lib/people';

export const getStaticPaths = (() => Object.entries(authorRegistry).map(([id, person]) => ({ params: { author: id }, props: { id, person } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { id, person } = Astro.props;
const pieces = (await getPublishedPieces()).filter(piece => piece.data.authors.includes(id));
---
<SiteLayout title={`${person.name} | Fidret`} description={id === 'hadi' ? 'Hadi Abou Daya is building Fidret and authors its Lab work on Physical AI, agent workflows and AI-assisted software delivery.' : `Published Fidret Lab pieces credited to ${person.name}. Authorship is recorded on each piece.`} canonical={`https://fidret.com/people/${id}/`} variant="lab">
  <main tabindex="-1" id="main" class="knowledge-page person-page">
    <header class="person-hero shell"><a class="text-link" href="/project/">About Fidret</a><h1>{person.name}</h1>{id === 'hadi' ? <><p class="visitor-lead">{hadiProfile.role}. Building Fidret.</p><p>{hadiProfile.background} He is based in {hadiProfile.location}.</p><p>At Fidret, he authors the published Lab work on Physical AI, agent workflows and AI-assisted software delivery. Each piece connects a practical question to its reasoning, sources and limitations.</p><div class="visitor-actions"><a class="button" href="/contact/">Discuss a project with Hadi</a><a class="text-link" href={hadiProfile.source}>Professional background</a></div></> : <p>Contributor to the shared Fidret Lab. Each publication records the people responsible for that piece.</p>}</header>

    <section class="person-pieces shell" aria-labelledby="pieces-title"><div class="knowledge-section-heading"><h2 id="pieces-title">Published pieces</h2>{pieces.length > 0 && <p>{pieces.length === 1 ? 'One published piece.' : `${pieces.length} published pieces.`}</p>}</div>
      {pieces.length > 0 ? <div class="knowledge-piece-list">{pieces.map(piece => <article class="knowledge-piece"><div class="knowledge-piece-meta"><span>{kindLabels[piece.data.kind]}</span><PublicationDate value={piece.data.published} /></div><div><h3><a href={`/lab/${piece.data.slug}/`}>{piece.data.title}</a></h3><p>{piece.data.summary}</p><p class="knowledge-piece-credit">By <Byline authors={piece.data.authors} /></p></div></article>)}</div> : <div class="person-empty"><p>Published contributions will be listed here with their actual bylines. Explore the current work in the meantime.</p><a class="text-link" href="/lab/">Explore the Lab</a></div>}
    </section>
    <aside class="person-context shell"><h2>About Fidret</h2><div><p>Fidret is developing its first practice in Physical AI. Its Lab shares questions, methods, takeaways and limits as the work grows.</p><a class="text-link" href="/project/">About Fidret</a></div></aside>
    {id === 'hadi' && <ProjectInvitation />}
  </main>
</SiteLayout>
