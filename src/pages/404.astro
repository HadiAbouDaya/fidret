---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | Fidret" variant="minimal" noindex>
  <main tabindex="-1" class="nf-main shell" id="main">
    <div class="nf-coordinate" aria-hidden="true">404</div>
    <div class="nf-copy">
      <h1>Page not found.</h1>
      <p>We couldn’t find a page at this address. Check the URL or use one of the links below.</p>
      <div class="nf-links">
        <a class="button" href="/">Go to the homepage</a>
        <a class="text-link" href="/work/">Explore our work</a>
      </div>
    </div>
  </main>
</SiteLayout>
