---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Byline from '../../components/Byline.astro';
import PublicationDate from '../../components/PublicationDate.astro';
import AgenticBoundary from '../../components/AgenticBoundary.astro';
import '../../styles/article.css';
import { getPublishedPieces } from '../../lib/lab';
import { kindLabels } from '../../lib/lab-schema';
import { HARNESS_SLUG, GUIDE_PATH } from '../../lib/workflow-brief';

export const getStaticPaths = (async () => {
  const pieces = await getPublishedPieces();
  return pieces.map((piece) => ({
    params: { slug: piece.data.slug },
    props: { piece },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { piece } = Astro.props;
const { Content, headings } = await render(piece);
const readingGuide = headings.filter((heading) => heading.depth === 2);
// Authored heading slugs share this document's ID namespace.
const usedIds = new Set(['main', ...headings.map((heading) => heading.slug)]);
const unusedId = (base: string) => {
  let id = base;
  for (let suffix = 2; usedIds.has(id); suffix += 1) id = `${base}-${suffix}`;
  usedIds.add(id);
  return id;
};
const resourcesId = unusedId('piece-resources');
const resourcesTitleId = unusedId('resources-title');
const briefTitleId = unusedId('workflow-brief-title');
const resources = piece.data.resources ?? [];
const [cover, ...additionalMedia] = piece.data.media ?? [];
const hasBoundaryExperience = piece.data.slug === HARNESS_SLUG;
---

<SiteLayout
  title={`${piece.data.title} — Fidret Lab`}
  description={piece.data.summary}
  canonical={`https://fidret.com/lab/${piece.data.slug}/`}
  variant="lab"
>
  <main id="main" class="lab-main">
    <article class="lab-piece shell">
      <a class="lab-back" href="/lab/">Fidret Lab</a>
      <header class="lab-piece-heading">
        <p class="lab-kind">{kindLabels[piece.data.kind]}</p>
        <h1>{piece.data.title}</h1>
        <p class="lab-lead">{piece.data.summary}</p>
        <div class="lab-piece-meta">
          <div class="lab-byline">By <Byline authors={piece.data.authors} /></div>
          <div class="lab-dates">
            <span>Published <PublicationDate value={piece.data.published} /></span>
            {piece.data.updated !== piece.data.published && (
              <span>Updated <PublicationDate value={piece.data.updated} /></span>
            )}
          </div>
        </div>
        {hasBoundaryExperience && <div class="hero-actions lab-experience-jump"><a class="text-link" href="#authority-bench">Inspect an authority boundary</a><a class="text-link" href={GUIDE_PATH}>Plan your first workflow</a></div>}
      </header>
      {cover && <figure class:list={['lab-cover', {'lab-cover--architecture': hasBoundaryExperience}]}><div class="lab-cover-scroll" tabindex={hasBoundaryExperience ? 0 : undefined} role={hasBoundaryExperience ? 'region' : undefined} aria-label={hasBoundaryExperience ? 'Scrollable control-boundary architecture diagram' : undefined}><img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} /></div>{hasBoundaryExperience && <p class="lab-cover-hint">Scroll the diagram horizontally on a narrow screen to inspect every boundary.</p>}<figcaption>{cover.caption} <a href={cover.src}>Open the figure</a></figcaption></figure>}
      <div class="lab-reading-grid">
        <aside class="lab-reading-guide">
          <nav aria-label="In this piece">
            <p>In this piece</p>
            <ol>
              {readingGuide.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
              {resources.length > 0 && <li><a href={`#${resourcesId}`}>Resources</a></li>}
            </ol>
          </nav>
        </aside>
        <div class="lab-piece-body">
          <div class="lab-prose"><Content /></div>
          {additionalMedia.map((media) => (
            <figure class="lab-figure">
              <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
              <figcaption>{media.caption}</figcaption>
            </figure>
          ))}
          {(piece.data.snippets ?? []).map((snippet) => (
            <figure class="lab-code">
              <figcaption>{snippet.title} ({snippet.language})</figcaption>
              <pre><code>{snippet.code}</code></pre>
            </figure>
          ))}
          {resources.length > 0 && <section class="lab-section" id={resourcesId} aria-labelledby={resourcesTitleId}>
            <h2 id={resourcesTitleId}>Resources</h2>
            <ul class="lab-resources">
              {resources.map((resource) => <li><a href={resource.url}>{resource.label}</a></li>)}
            </ul>
          </section>}
          {hasBoundaryExperience && <aside class="lab-brief-callout" aria-labelledby={briefTitleId}><h2 id={briefTitleId}>Take one workflow into a review.</h2><p>Five contracts, a worked example and failure cases to discuss with your team. Take an editable brief with you.</p><a class="text-link" href={GUIDE_PATH}>Open the workflow brief</a></aside>}
          <aside class="lab-publication-notes"><p>Keep the references and publication record with the piece.</p><a class="text-link" href={`/lab/${piece.data.slug}/sources/`}>Sources and publication notes</a></aside>
          <nav class="lab-piece-footer" aria-label="Lab navigation">
            <a class="lab-back" href="/lab/">Back to Fidret Lab</a>
          </nav>
        </div>
      </div>
      {hasBoundaryExperience && <section class="lab-boundary-section" id="authority-bench" aria-labelledby="authority-bench-title"><div class="lab-boundary-intro"><h2 id="authority-bench-title">Inspect the boundary.</h2><p>A fictional support investigation can lead to very different requests. Choose one to see what a proposed authority contract would require.</p></div><AgenticBoundary /></section>}
    </article>
  </main>
</SiteLayout>
