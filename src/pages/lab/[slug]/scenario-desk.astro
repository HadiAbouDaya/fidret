---
import type {GetStaticPaths} from 'astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ScenarioLibrary from '../../../components/ScenarioLibrary.astro';
import {getPublishedPieces} from '../../../lib/lab';
import {FARM_SLUG,FARM_DESK_PATH} from '../../../lib/autonomous-farm';
export const getStaticPaths=(async()=>(await getPublishedPieces()).filter(p=>p.data.slug===FARM_SLUG).map(p=>({params:{slug:p.data.slug}}))) satisfies GetStaticPaths;
---
<SiteLayout title="Autonomous farm: situation library | Fidret Lab" description="Find one of 28 fictional farm situations, from water and animal care to food lineage, cloud outages and uncertain commands." canonical={`https://fidret.com${FARM_DESK_PATH}`} variant="lab"><main id="main" tabindex="-1" class="reference-page shell"><ScenarioLibrary kind="farm"/></main></SiteLayout>
