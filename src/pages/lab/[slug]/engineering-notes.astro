---
import type {GetStaticPaths,InferGetStaticPropsType} from 'astro';
import {render} from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Byline from '../../../components/Byline.astro';
import PublicationDate from '../../../components/PublicationDate.astro';
import {getPublishedPieces} from '../../../lib/lab';
import {FACTORY_SLUG,stations} from '../../../lib/software-factory';
import {factoryJourney} from '../../../lib/lab-journeys';
import runtimeUrl from '../../../scripts/lab-experience.js?url&no-inline';
import '../../../styles/article.css';
import '../../../styles/lab-experience.css';
export const getStaticPaths=(async()=>(await getPublishedPieces()).filter(p=>p.data.slug===FACTORY_SLUG).map(piece=>({params:{slug:piece.data.slug},props:{piece}}))) satisfies GetStaticPaths;
type Props=InferGetStaticPropsType<typeof getStaticPaths>;
const {piece}=Astro.props;const {Content,headings}=await render(piece);
const aliases:Record<string,string>={'make-progress-durable-and-uncertainty-explicit':'timeout receipt retry idempotency durable','remain-responsible-after-promotion':'recovery rollback incident operations','automate-service-within-a-reviewed-policy':'rollout canary observation','prepare-context-without-turning-it-into-authority':'permissions tools access injection security','give-responsibility-an-actual-operating-shape':'accountability human authority'};
const topics=headings.filter(h=>h.depth===3||h.depth===2&&['question','limits','next-steps'].includes(h.slug));
---
<SiteLayout title="AI software factory: engineering notes | Fidret Lab" description="Find the software-factory contract you need: context, authority, exact evidence, release, recovery, responsibility and economics." canonical={`https://fidret.com${factoryJourney.notes}`} variant="lab">
<main id="main" tabindex="-1" class="reference-page shell"><header class="reference-heading"><a class="text-link" href={factoryJourney.path} data-story-return data-return-scenes={factoryJourney.steps.map(s=>s.key).join(' ')} data-return-labels={factoryJourney.steps.map(s=>s.short).join('|')}>Release workspace</a><h1>The engineering behind the factory.</h1><p>Read the complete architecture, or jump to the question you came to inspect. The kitchen analogy is an explanation, not a software certification.</p><p>By <Byline authors={piece.data.authors}/>. Published <PublicationDate value={piece.data.published!}/>{piece.data.updated!==piece.data.published && <> · Updated <PublicationDate value={piece.data.updated}/></>}</p><nav class="reference-routes" aria-label="Lab reading routes"><a href={factoryJourney.path}>Release workspace</a><a href={factoryJourney.library}>Release situations</a><a href={factoryJourney.brief} download>Operating brief</a><a href={`${factoryJourney.path}sources/`}>Sources and edition</a></nav></header>
<div class="reference-reading"><aside class="reference-index" data-topic-finder><div class="reference-finder" data-only-enhanced hidden><label for="factory-topic-search">Find a topic</label><div class="reference-search-row"><input id="factory-topic-search" type="search" placeholder="Try context, evidence or recovery" autocomplete="off"/><button type="button" data-clear>Clear</button></div><p role="status" data-find-status aria-atomic="true">{topics.length} topics shown</p></div><nav aria-label="Engineering topics"><ol>{topics.map(h=><li data-find-item data-find-text={`${h.text} ${h.slug} ${aliases[h.slug]||''}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><p data-find-empty hidden>No matching topic. <button type="button" data-clear>Show all topics</button>.</p><a class="text-link" href="#lifecycle">Seven lifecycle handoffs</a></aside><div class="reference-prose lab-prose"><Content/><section id="lifecycle" class="reference-lifecycle"><h2>Seven lifecycle handoffs</h2><p>The stages explain responsibilities and artifacts. Real work can loop, overlap and wait for evidence.</p><ol>{stations.map(s=><li><details><summary>{s.name}</summary><p>{s.action}</p><p><strong>AI work:</strong> {s.agent}</p><p><strong>Human responsibility:</strong> {s.human}</p><p><strong>{s.artifact}:</strong> {s.handoff}</p></details></li>)}</ol></section></div></div><footer class="reference-ending"><a class="button" href={factoryJourney.path} data-story-return data-return-scenes={factoryJourney.steps.map(s=>s.key).join(' ')} data-return-labels={factoryJourney.steps.map(s=>s.short).join('|')}>Release workspace</a><a class="text-link" href={factoryJourney.brief} download>Take the operating brief</a></footer></main>
<script is:inline type="module" src={runtimeUrl}></script>
</SiteLayout>
