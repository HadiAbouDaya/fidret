---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Byline from '../../../components/Byline.astro';
import PublicationDate from '../../../components/PublicationDate.astro';
import { getPublishedPieces } from '../../../lib/lab';
import { kindLabels } from '../../../lib/lab-schema';
import '../../../styles/article.css';
export const getStaticPaths = (async () => (await getPublishedPieces()).map(piece => ({params: {slug: piece.data.slug}, props: {piece}}))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const {piece} = Astro.props;
const resources = piece.data.resources ?? [];
---
<SiteLayout title={`Sources and publication notes — ${piece.data.title}`} description={`References, authorship and current publication dates for ${piece.data.title}.`} canonical={`https://fidret.com/lab/${piece.data.slug}/sources/`} variant="lab">
  <main id="main" class="sources-page shell">
    <header class="sources-heading"><a class="text-link" href={`/lab/${piece.data.slug}/`}>Back to the piece</a><p class="section-context">Sources and publication notes</p><h1>Keep the evidence<br />with the argument.</h1><p class="sources-piece-title">{piece.data.title}</p><p class="sources-intro">The references and publication record for this edition. A source’s date and scope matter as much as the claim it supports.</p></header>
    <div class="sources-grid">
      <aside class="sources-edition" aria-labelledby="edition-title"><h2 id="edition-title">This edition</h2><dl><div><dt>By</dt><dd><Byline authors={piece.data.authors} /></dd></div><div><dt>Format</dt><dd>{kindLabels[piece.data.kind]}</dd></div><div><dt>Published</dt><dd><PublicationDate value={piece.data.published} /></dd></div><div><dt>Latest update</dt><dd><PublicationDate value={piece.data.updated} /></dd></div></dl><p>These dates describe the current published edition. Each piece keeps its own byline and scope.</p></aside>
      <section class="sources-references" aria-labelledby="references-title"><h2 id="references-title">References</h2><p>Primary material is linked at its original publisher. Living documentation can change after an article is written.</p>{resources.length > 0 ? <ul>{resources.map(resource => <li><a href={resource.url}>{resource.label}</a><span>{resource.url.startsWith('/') ? 'Fidret' : new URL(resource.url).hostname}</span></li>)}</ul> : <p class="sources-empty">This edition lists no external references.</p>}</section>
    </div>
    <nav class="sources-return" aria-label="Continue reading"><a class="button" href={`/lab/${piece.data.slug}/`}>Read the piece</a><a class="text-link" href="/lab/">All Lab pieces</a></nav>
  </main>
</SiteLayout>
