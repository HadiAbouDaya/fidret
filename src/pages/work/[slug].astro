---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkEvidence from '../../components/WorkEvidence.astro';
import ProjectInvitation from '../../components/ProjectInvitation.astro';
import { getPublishedPieces } from '../../lib/lab';
import { visibleWork } from '../../lib/work';
import '../../styles/visitor.css';

export async function getStaticPaths() {
  const publishedWorks = visibleWork((await getPublishedPieces()).map(piece => piece.data.slug));
  return publishedWorks.map(work => ({ params: { slug: work.slug }, props: { work, publishedWorks } }));
}

const { work, publishedWorks } = Astro.props;
---
<SiteLayout title={`${work.title} | Fidret work`} description={work.contribution} canonical={`https://fidret.com/work/${work.slug}/`}>
  <main id="main" tabindex="-1">
    <header class="visitor-hero work-detail-hero shell">
      <a class="text-link" href="/work/">All work</a>
      <p class="work-kind">{work.kind}</p>
      <h1>{work.title}</h1>
      <p class="visitor-lead">{work.question}</p>
      <p class="work-scope">{work.scope}</p>
      <div class="visitor-actions">
        <a class="button" href={work.artifact}>{work.artifactLabel}</a>
      </div>
    </header>

    <section class="work-overview shell" aria-labelledby="contribution-title">
      <div>
        <h2 id="contribution-title">What we made</h2>
        <p class="visitor-lead">{work.contribution}</p>
        <p>{work.relevance}</p>
      </div>
      <div>
        <h3>What you can explore</h3>
        <p>{work.explore}</p>
        <h3>What it shows</h3>
        <p>{work.finding}</p>
      </div>
    </section>

    <WorkEvidence work={work} publishedWorks={publishedWorks} />

    <section class="work-evidence inverse">
      <div class="shell visitor-split">
        <h2>Scope and next steps</h2>
        <div>
          <p>{work.limit}</p>
          <h3>What comes next</h3>
          <p>{work.nextEvidence}</p>
          <a class="text-link" href={work.method}>{work.methodLabel}</a>
        </div>
      </div>
    </section>

    <ProjectInvitation title="Have a related question?" description={work.invitation} />
  </main>
</SiteLayout>
