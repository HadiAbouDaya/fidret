---
import SiteLayout from '../layouts/SiteLayout.astro';
import ObservationField from '../components/ObservationField.astro';
import Byline from '../components/Byline.astro';
import PublicationDate from '../components/PublicationDate.astro';
import { getPublishedPieces } from '../lib/lab';
const [latestPiece] = await getPublishedPieces();
---
<SiteLayout
  title="Fidret — Trust earned."
  description="Expertise that earns trust through sound judgment, useful work and reliable delivery. Developing our first practice in Physical AI."
  canonical="https://fidret.com/"
>
  <main id="main">
    <section class="home-hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-context">Trust earned.</p>
        <h1 id="hero-title">Building a Physical AI practice.</h1>
        <p class="hero-intro">Fidret is a company taking shape around expertise clients can rely on. We’re starting with systems that use observations of the physical world to support decisions and actions.</p>
        <div class="hero-actions">
          <a class="button" href="/explorations/signal-freshness/">Explore the signal experiment</a>
          <a class="text-link" href="/approach/">Our approach</a>
        </div>
      </div>
      <ObservationField />

    </section>

    <section id="physical-ai" class="practice-section inverse" aria-labelledby="practice-title">
      <div class="shell practice-grid">
        <div class="practice-heading">
          <h2 id="practice-title">From observations to decisions</h2>
          <p class="practice-lead">A model’s output is only part of a physical system.</p>
        </div>
        <div class="practice-detail">
          <p>Sensor quality, timing and changing conditions affect what a system can reliably do. Integration and the people operating it need to be considered from the start.</p>
          <p>Our practice begins with software experiments that test a specific rule. Equipment trials and delivery commitments require further evidence under the intended conditions.</p>
          <a class="text-link" href="/charter/">Our commitments</a>
        </div>

      </div>
    </section>

    <section class="home-workbench shell" aria-labelledby="workbench-title">
      <div class="workbench-intro">
        <div><h2 id="workbench-title">When is a reading too old?</h2></div>
        <p>Our signal experiment tests a three-second age limit. See when a delayed reading is withheld and what has to happen before the system accepts readings again.</p>
      </div>
      <a class="experiment-preview" href="/explorations/signal-freshness/">
        <div class="experiment-copy"><span class="experiment-kind">Synthetic software exploration</span><h3>Signal freshness</h3><p>Inspect a fixed sequence, from a fresh reading to expiry and recovery.</p><span class="experiment-action">Open the walkthrough</span></div>
        <div class="signal-preview" aria-hidden="true">
          <div class="preview-clock"><span>Observation time</span><span>Arrival time</span></div>
          <svg viewBox="0 0 580 265"><path class="preview-guide" d="M36 56H544M36 201H544M36 128H544"/><path class="preview-tick" d="M76 48v16m106-16v16m106-16v16m106-16v16M76 193v16m106-16v16m106-16v16m106-16v16m106-16v16"/><path class="preview-good" d="M76 56L130 201M182 56L236 201M394 56L448 201"/><path class="preview-delay" d="M288 56L500 201"/><g class="preview-node"><circle cx="76" cy="56" r="6"/><circle cx="182" cy="56" r="6"/><circle cx="394" cy="56" r="6"/><circle cx="130" cy="201" r="6"/><circle cx="236" cy="201" r="6"/><circle cx="448" cy="201" r="6"/></g><g class="preview-late-node"><circle cx="288" cy="56" r="6"/><circle cx="500" cy="201" r="6"/></g><path class="preview-annotation" d="M385 122h78"/><text x="385" y="105" class="preview-label">Late arrival</text></svg>
          <div class="preview-explanation"><span class="preview-key" aria-hidden="true"></span><span>Arrival alone doesn’t make an observation current.</span></div>
        </div>
      </a>
      <div class="workbench-footer"><p>Synthetic data and fixed snapshots. The three-second limit is illustrative; no hardware was tested.</p><a class="text-link" href="/lab/">More from Fidret Lab</a></div>
    </section>

    {latestPiece && <section class="latest-lab shell" aria-labelledby="latest-title"><div class="latest-lab-heading"><h2 id="latest-title">From the Lab</h2><p>Technical writing from Fidret</p></div><article><p class="latest-lab-date"><PublicationDate value={latestPiece.data.published} /></p><h3><a href={`/lab/${latestPiece.data.slug}/`}>{latestPiece.data.title}</a></h3><p>{latestPiece.data.summary}</p><p class="latest-lab-credit">By <Byline authors={latestPiece.data.authors} /></p></article></section>}

  </main>
</SiteLayout>
