---
import { projectContact } from '../lib/contact';
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'An early idea is enough.',
  description = 'Tell us what is happening and what you would like to change. A question or one example is enough to start a conversation.',
} = Astro.props;
---
<aside class="project-invitation shell" aria-label="Discuss a project">
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <a class="button" href={projectContact.path}>Talk about an idea</a>
</aside>
