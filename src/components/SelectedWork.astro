---
import type { Work } from '../lib/work';
import { workPath } from '../lib/work';
import WorkArtifact from './WorkArtifact.astro';
interface Props { works: Work[]; headingLevel?: 2 | 3; }
const { works, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<div class="selected-work-list">
  {works.map(work => (
    <article class="selected-work">
      <div class="selected-work-copy">
        <Heading><a href={workPath(work)}>{work.title}</a></Heading>
        <p>{work.question}</p>
        <p class="work-made"><strong>What we made:</strong> {work.contribution}</p>
        <p class="work-kind">{work.scope}</p>
        <a class="text-link" href={workPath(work)}>{work.overviewLabel}</a>
      </div>
      <div class="work-visual-link"><WorkArtifact kind={work.preview} /></div>
    </article>
  ))}
</div>
