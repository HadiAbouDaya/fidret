---
import type { Work } from '../lib/work';
import { workPath } from '../lib/work';
import WorkArtifact from './WorkArtifact.astro';
interface Props {
  works: Work[];
}

const { works } = Astro.props;
---
<div class="selected-work-list">
  {works.map(work => (
    <article class="selected-work">
      <div class="selected-work-copy">
        <p class="work-kind">{work.kind}</p>
        <h3><a href={workPath(work)}>{work.title}</a></h3>
        <p>{work.question}</p>
        <p>{work.contribution}</p>
        <a class="text-link" href={workPath(work)}>View the contribution and evidence</a>
      </div>
      <div class="work-visual-link">
        <WorkArtifact kind={work.preview} />
      </div>
    </article>
  ))}
</div>
