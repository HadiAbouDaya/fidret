---
import type { Work } from '../lib/work';
import { workPath } from '../lib/work';
interface Props { work: Work; }
const { work } = Astro.props;
---
<aside class="work-context" aria-label="About this work"><p><strong>What we made:</strong> {work.contribution}</p><a class="text-link" href={workPath(work)}>Contribution, relevance and evidence</a></aside>
