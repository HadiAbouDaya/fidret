---
import '../styles/farm-map.css';
import {FARM_BLUEPRINT_PATH} from '../lib/autonomous-farm';
// Equivalent HTML links below keep sequential focus visible in narrow SVG scroll regions.
---
<figure class="farm-map">
  <div class="farm-map-scroll" tabindex="0" role="region" aria-label="Scrollable conceptual farm plan"><svg viewBox="0 0 760 400" role="group" aria-labelledby="farm-map-title" aria-describedby="farm-map-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="farm-map-title">One farm, coupled resources</title><desc id="farm-map-desc">Fields and greenhouse share water and energy with dairy cattle, sheep and poultry. Local controls connect to cloud planning. Food handling and manure use separate routes. This is a conceptual plan, without real scale or measurements.</desc>
    <rect class="map-ground" x="2" y="2" width="756" height="396" rx="14" />
    <path class="map-water-path" d="M105 70H680M105 70V310M105 170H680" />
    <path class="map-clean-path" d="M210 315H680V255M435 315V255" />
    <path class="map-dirty-path" d="M230 370H645V350M645 370V330" />
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#water`}><rect class="map-reservoir" x="32" y="32" width="145" height="77" rx="18" /><text class="map-label map-light" x="104" y="62" text-anchor="middle">Water reserve</text><text class="map-small map-light" x="104" y="86" text-anchor="middle">quality + allocation</text></a>
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#crops`}><rect class="map-field" x="215" y="30" width="205" height="88" rx="5" /><path class="map-crop-lines" d="M235 48H400M235 65H400M235 82H400M235 99H400" /><rect class="map-label-bg" x="247" y="53" width="142" height="40" rx="4" /><text class="map-label" x="318" y="79" text-anchor="middle">Outdoor crops</text><path class="map-building" d="M465 100V55L555 23L645 55V100Z" /><path class="map-greenhouse" d="M495 55V100M525 35V100M555 25V100M585 35V100M615 45V100" /><text class="map-label" x="555" y="84" text-anchor="middle">Greenhouse</text></a>
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#livestock`}><rect class="map-building" x="215" y="148" width="125" height="111" rx="5"/><rect class="map-field" x="365" y="148" width="124" height="111" rx="5"/><rect class="map-building" x="515" y="148" width="165" height="111" rx="5"/><text class="map-label" x="278" y="186" text-anchor="middle">Dairy cattle</text><text class="map-small" x="278" y="213" text-anchor="middle">milk + care</text><text class="map-label" x="427" y="186" text-anchor="middle">Sheep</text><text class="map-small" x="427" y="213" text-anchor="middle">pasture + care</text><text class="map-label" x="597" y="186" text-anchor="middle">Poultry houses</text><text class="map-small" x="597" y="213" text-anchor="middle">eggs + broilers</text></a>
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#architecture`}><rect class="map-controller" x="25" y="203" width="151" height="90" rx="5"/><text class="map-label map-light" x="101" y="233" text-anchor="middle">Local controls</text><text class="map-small map-light" x="101" y="260" text-anchor="middle">protect + observe</text><path class="map-cloud-path" d="M100 293V325"/><text class="map-small" x="101" y="348" text-anchor="middle">Cloud plans above</text><text class="map-small" x="101" y="370" text-anchor="middle">local boundaries</text></a>
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#food`}><rect class="map-label-bg" x="330" y="295" width="260" height="38" rx="4"/><text class="map-label" x="460" y="320" text-anchor="middle">Food lots and handlers</text></a>
    <a tabindex="-1" href={`${FARM_BLUEPRINT_PATH}#biosecurity`}><rect class="map-label-bg" x="310" y="349" width="290" height="36" rx="4"/><text class="map-small" x="455" y="373" text-anchor="middle">Separate manure and cleaning routes</text></a>
  </svg></div>

  <nav class="farm-map-links" aria-label="Farm plan boundaries"><a href={`${FARM_BLUEPRINT_PATH}#water`}>Water</a><a href={`${FARM_BLUEPRINT_PATH}#crops`}>Crops</a><a href={`${FARM_BLUEPRINT_PATH}#livestock`}>Animals</a><a href={`${FARM_BLUEPRINT_PATH}#architecture`}>Local and cloud</a><a href={`${FARM_BLUEPRINT_PATH}#food`}>Food lots</a><a href={`${FARM_BLUEPRINT_PATH}#biosecurity`}>Clean routes</a></nav>
  <figcaption>Conceptual farm plan. Solid copper lines show shared water; green lines show food handling; dashed lines show separate dirty work. No scale, live measurements or built farm are implied. Scroll the plan horizontally on a phone. The boundary links accompany the plan.</figcaption>
</figure>
