---
import type {LabJourney} from '../lib/lab-journeys';
import Byline from './Byline.astro';
import PublicationDate from './PublicationDate.astro';
import WorkspaceArtifact from './WorkspaceArtifact.astro';
import {workspacesFor} from '../lib/lab-workspaces';
import {workForSource,workPath} from '../lib/work';
import runtimeUrl from '../scripts/lab-experience.js?url&no-inline';
import '../styles/lab-experience.css';
import '../styles/workspace.css';
interface Props {journey:LabJourney;authors:string[];published:string;updated:string;sibling?:LabJourney;legacyHeadings?:{slug:string;text:string}[]}
const {journey,authors,published,updated,sibling,legacyHeadings=[]}=Astro.props;
const cases=workspacesFor(journey.kind);
const selectorLabels=journey.kind==='farm'?['Water','Evidence','Animal care','Lost receipt','Cloud outage']:['Candidate','Lost receipt','Impact','Authority','After release'];
const work=workForSource(journey.kind==='farm'?'autonomous-farm':'ai-software-factory')!;
const ids=new Set(journey.steps.map(s=>`scene-${s.key}`));
const farmLegacy:Record<string,string>={question:'architecture',approach:'architecture','the-short-version-observe-decide-act-check':'architecture','the-agents-have-different-jobs':'agents','different-living-systems-need-different-plans':'crops','milk-eggs-vegetables-and-meat-remain-traceable':'food','the-farmer-receives-decisions-not-just-notifications':'people',takeaways:'evaluation','local-protection-keeps-its-own-authority':'welfare','some-effects-cannot-be-retried-casually':'commands','security-and-sovereignty-include-the-whole-path':'security',limits:'research','next-steps':'evaluation'};
---
<div class:list={['lab-experience','shell',`lab-experience--${journey.kind}`]} data-lab-journey>
  <p class="visually-hidden" role="status" aria-atomic="true" data-announce></p>
  <header class="experience-heading"><div class="experience-intro"><div><h1>{journey.title}</h1><p class="experience-lead">{journey.kind==='farm'?'A farm architecture and editable policy model. Change the conditions that govern a proposed action.':'A release architecture and editable policy model. Change the evidence and permission around a proposed software release.'}</p></div><div class="experience-metadata"><p class="experience-credit">By <Byline authors={authors} /></p><p class="experience-dates">Published <PublicationDate value={published}/>{updated!==published&&<>. Updated <PublicationDate value={updated}/></>}</p><p class="experience-scope">A teaching model. No real {journey.kind==='farm'?'farm or equipment':'customers or deployment service'} is connected.</p><a href={workPath(work)}>About this work</a><a href={journey.notes}>Engineering notes</a></div></div></header>
  <section class="journey" id="read-all" aria-label={journey.kind==='farm'?'Farm decision workspace':'Software release workspace'}>
    <label class="workspace-situation-select" data-only-enhanced hidden><span>Explore a situation</span><select data-scene-select>{journey.steps.map((step,i)=><option value={step.key}>{selectorLabels[i]}</option>)}</select></label>
    <nav class="journey-progress" aria-label="Situations"><ol>{journey.steps.map((step,i)=><li><a href={`#scene-${step.key}`}><span aria-hidden="true">{i+1}</span>{step.short}</a></li>)}</ol></nav>
    <div class="journey-chapters">{journey.steps.map((step,i)=>{
      const model=cases[i]!;const initial=model.states[model.initial]!;
      return <article class="journey-chapter" id={`scene-${step.key}`} data-scene data-key={step.key} data-initial={model.initial} data-model={JSON.stringify(model.states)} data-response={initial.decision}>
        <header class="journey-chapter-heading"><div><p>Situation {i+1} of {journey.steps.length}</p><h2 tabindex="-1">{model.title}</h2><p class="journey-context">{model.context}</p></div></header>
        <div class="workspace-stage"><div class="workspace-inputs"><p class="workspace-instruction" data-only-enhanced hidden>Change a condition</p><div class="workspace-controls" data-only-enhanced hidden>{model.controls.map((control,j)=><label><span>{control.label}</span><select data-model-input={j} aria-controls={`result-${step.key}`}>{control.options.map((option,k)=><option value={k}>{option}</option>)}</select></label>)}</div><dl class="workspace-static" data-static-answer>{model.controls.map(control=><div><dt>{control.label}</dt><dd>{control.options[0]}</dd></div>)}</dl></div>
          <div class="workspace-system"><section class="workspace-result" id={`result-${step.key}`} aria-labelledby={`response-${step.key}`}><p class="workspace-result-label">Primary model response</p><h3 id={`response-${step.key}`} data-response-label>{initial.label}</h3><ul class="workspace-reasons">{Array.from({length:10},(_,j)=><li data-reason hidden={j>=initial.reasons.length}>{initial.reasons[j]||''}</li>)}</ul><p class="workspace-priority" data-priority-note hidden={!['protect','reconcile','recorded','contain'].includes(initial.decision)}>This response takes priority. Other requirements still need checking before new work.</p><p class="workspace-baseline" data-baseline hidden>Starting response: {initial.label}</p></section><WorkspaceArtifact kind={journey.kind} scene={step.key} state={initial}/></div>
        </div>
        <div class="workspace-depth"><div><p class="workspace-challenge" data-only-enhanced hidden><strong>Try this</strong>{model.challenge}</p><details><summary>Inspect the reasoning and assumptions</summary><ol class="workspace-trace" aria-label="Model evaluation">{initial.trace.map(t=><li data-trace-status={t.status}><strong>{t.label}</strong><span data-trace-value>{t.value}</span><span class="workspace-trace-status" data-trace-label>{t.status==='deferred'?'Not evaluated here':t.status==='priority'?'Priority response':t.status==='blocked'?'Unresolved':'Established'}</span></li>)}</ol><p><strong>Held constant:</strong> {model.fixed}</p><p>{step.lesson}</p><p><strong>Responsible people:</strong> {step.owner}</p><p><strong>Evidence to seek:</strong> {step.nextEvidence}</p><a data-workspace-note href={step.notePath.replace('#',`?scene=${step.key}#`)}>Read this engineering boundary</a></details></div><div class="workspace-share" data-only-enhanced hidden><button class="workspace-reset" type="button" data-reset-case>Reset this situation</button><a data-share href={`#scene-${step.key}`}>Link to these conditions</a><p data-state-description>Starting conditions</p></div></div>
        <footer class="journey-actions">{i>0?<a href={`#scene-${journey.steps[i-1]!.key}`} data-direction="back">Previous situation</a>:<a href={journey.library}>Browse all situations</a>}{i<journey.steps.length-1?<a class="button" href={`#scene-${journey.steps[i+1]!.key}`} data-direction="next">Explore: {journey.steps[i+1]!.short.toLowerCase()}</a>:<a class="button" href="#story-complete" data-complete>Explore the full design</a>}</footer>
      </article>;
    })}</div>
  </section>
  <div class="journey-tools"><a href="#read-all">Read all five situations</a><button type="button" data-reset data-only-enhanced hidden>Reset all situations</button></div>
  <section class="experience-completion" id="story-complete" tabindex="-1"><h2>Take the model back to the engineering.</h2><p>{journey.kind==='farm'?'Local protection, uncertain effects and qualified people remain part of the design.':'Exact evidence, current authority and responsibility after release remain part of delivery.'}</p><a class="experience-return" href={`#scene-${journey.steps[journey.steps.length-1]!.key}`}>Return to the last situation</a><div class="experience-next-links"><a href={journey.library}><strong>Explore more situations</strong><span>{journey.kind==='farm'?'All 28 farm cases, organized for lookup.':'Five release situations and the complete lifecycle.'}</span></a><a href={journey.notes}><strong>Inspect the engineering</strong><span>Full reasoning, sources and limits.</span></a><a href={journey.brief} download={`fidret-${journey.kind}-operating-brief.md`}><strong>Take the operating brief</strong><span>Editable Markdown for your own discussion.</span></a></div>{sibling && <a class="experience-other" href={sibling.path}>Try the {sibling.kind==='factory'?'software-factory':'autonomous-farm'} workspace</a>}<p><a class="text-link" href="/contact/">Discuss a related project</a></p><p class="experience-limit">The situations use a small teaching model. They do not simulate a real {journey.kind==='farm'?'farm, animal or robot':'engineering organization or production service'}, certify a design or grant execution authority. The engineering notes retain the research and full limits.</p><a href={`${journey.path}sources/`}>Sources and publication record</a></section>
  {legacyHeadings.filter(h=>!ids.has(h.slug)&&!['read-all','story-complete','main'].includes(h.slug)).map(h=><p class="experience-legacy" id={h.slug}><a href={`${journey.notes}#${journey.kind==='farm'?(farmLegacy[h.slug]||'architecture'):h.slug}`}>{h.text} is now in the engineering notes. Open this section.</a></p>)}
</div>
<script is:inline type="module" src={runtimeUrl}></script>
