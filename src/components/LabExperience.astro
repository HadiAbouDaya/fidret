---
import type {LabJourney} from '../lib/lab-journeys';
import Byline from './Byline.astro';
import PublicationDate from './PublicationDate.astro';
import JourneyScene from './JourneyScene.astro';
import runtimeUrl from '../scripts/lab-experience.js?url&no-inline';
import '../styles/lab-experience.css';
interface Props {journey:LabJourney;authors:string[];published:string;updated:string;legacyHeadings?:{slug:string;text:string}[]}
const {journey,authors,published,updated,legacyHeadings=[]}=Astro.props;
const ids=new Set(journey.steps.map(s=>`scene-${s.key}`));
const farmLegacy:Record<string,string>={question:'architecture',approach:'architecture','the-short-version-observe-decide-act-check':'architecture','the-agents-have-different-jobs':'agents','different-living-systems-need-different-plans':'crops','milk-eggs-vegetables-and-meat-remain-traceable':'food','the-farmer-receives-decisions-not-just-notifications':'people',takeaways:'evaluation','local-protection-keeps-its-own-authority':'welfare','some-effects-cannot-be-retried-casually':'commands','security-and-sovereignty-include-the-whole-path':'security',limits:'research','next-steps':'evaluation'};
---
<div class:list={['lab-experience','shell',`lab-experience--${journey.kind}`]} data-lab-journey>
  <p class="visually-hidden" role="status" aria-atomic="true" data-announce></p><header class="experience-heading"><a class="lab-back" href="/lab/">Fidret Lab</a><h1>{journey.title}</h1><p class="experience-lead">{journey.lead}</p><p class="experience-credit">By <Byline authors={authors} /> <span>Five decisions. Explore at your own pace.</span></p><p class="experience-credit">Published <PublicationDate value={published}/>{updated!==published && <> · Updated <PublicationDate value={updated}/></>}</p><div class="experience-entry"><a class="button" href={`#scene-${journey.steps[0]!.key}`}>Start the story</a><a class="text-link" href={journey.notes}>Engineering notes</a></div><p class="experience-scope">A fictional walkthrough. No real {journey.kind==='farm'?'farm or equipment':'customers or deployment service'} is connected.</p></header>
  <div class="journey-orientation"><p><strong>Your goal</strong> {journey.goal}</p><div class="journey-tools"><a href="#read-all">Read all five scenes</a><button type="button" data-reset data-only-enhanced hidden>Start again</button></div></div>
  <section class="journey" id="read-all" aria-label={journey.kind==='farm'?'A morning on the farm':'A change through the software factory'}>
    <nav class="journey-progress" aria-label="Story scenes"><ol>{journey.steps.map((step,i)=><li><a href={`#scene-${step.key}`}><span aria-hidden="true">{i+1}</span>{step.short}</a></li>)}</ol></nav>
    <div class="journey-chapters">{journey.steps.map((step,i)=><article class="journey-chapter" id={`scene-${step.key}`} data-scene data-key={step.key} data-primary={step.decision} data-primary-label={step.decisionLabel} data-alternate={step.counter.decision} data-alternate-label={step.counter.label}>
      <header class="journey-chapter-heading"><p>Decision {i+1} of {journey.steps.length}</p><h2 tabindex="-1">{step.title}</h2></header>
      <div class="journey-stage"><div class="journey-task"><p class="journey-context">{step.context}</p><ul class="journey-evidence">{step.evidence.map(e=><li>{e}</li>)}</ul>
        </div><JourneyScene kind={journey.kind} step={step}/><div class="journey-decision"><fieldset class="journey-question" data-only-enhanced hidden><legend>{step.question}</legend>{step.choices.map(choice=><button type="button" data-choice={choice.decision} data-feedback={choice.feedback} aria-pressed="false" aria-controls={`result-${step.key}`}>{choice.label}<span class="journey-choice-marker" aria-hidden="true">●</span></button>)}<button type="button" class="journey-reveal" data-reveal>Show the explanation</button><div class="journey-quick-result" data-quick-result hidden><p class="journey-live" data-live></p></div></fieldset>
        <div class="journey-fallback-answer" data-static-answer><h3>{step.decisionLabel}</h3><p>{step.lesson}</p><p><strong>Who responds:</strong> {step.owner}</p></div>
      </div></div>
      <section class="journey-feedback" id={`result-${step.key}`} data-result hidden aria-labelledby={`lesson-${step.key}`}><div class="journey-lesson"><div><h3 id={`lesson-${step.key}`}>Why this matters</h3><p>{step.lesson}</p><p class="journey-owner"><strong>Who responds</strong> {step.owner}</p></div><aside><strong>Evidence to look for next</strong><p>{step.nextEvidence}</p><a href={step.notePath.replace('#',`?scene=${step.key}#`)}>Inspect this boundary</a></aside></div>
        <details class="journey-counter"><summary>Change one condition</summary><p>{step.counter.question}</p><button type="button" data-compare aria-pressed="false">Try the changed condition</button><div data-comparison hidden><p><strong>Changed:</strong> {step.counter.condition}</p><dl><div><dt>Original response</dt><dd>{step.decisionLabel}</dd></div><div><dt>Changed response</dt><dd>{step.counter.label}</dd></div></dl><p>{step.counter.explanation}</p></div></details>
      </section>
      <footer class="journey-actions">{i>0?<a href={`#scene-${journey.steps[i-1]!.key}`} data-direction="back">Previous scene</a>:<a href={journey.library}>Browse all situations</a>}{i<journey.steps.length-1?<a class="button" href={`#scene-${journey.steps[i+1]!.key}`} data-direction="next">Continue: {journey.steps[i+1]!.short.toLowerCase()}</a>:<a class="button" href="#story-complete" data-complete>Finish the story</a>}</footer>
    </article>)}</div>
  </section>
  <section class="experience-completion" id="story-complete" tabindex="-1"><h2>Explore a situation or inspect the design.</h2><p>{journey.kind==='farm'?'The farm can automate routine work while keeping local protection, uncertain effects and qualified people in the design.':'An AI-built change still needs exact evidence, current authority and people who stay responsible after release.'}</p><a class="experience-return" href={`#scene-${journey.steps[journey.steps.length-1]!.key}`}>Return to the last decision</a><div class="experience-next-links"><a href={journey.library}><strong>Explore more situations</strong><span>{journey.kind==='farm'?'All 28 farm cases, organized for lookup.':'Five release situations and the complete lifecycle.'}</span></a><a href={journey.notes}><strong>Inspect the engineering</strong><span>Full reasoning, sources and limits.</span></a><a href={journey.brief} download={`fidret-${journey.kind}-operating-brief.md`}><strong>Take the operating brief</strong><span>Editable Markdown for your own discussion.</span></a></div><a class="experience-other" href={journey.kind==='farm'?'/lab/ai-software-factory/':'/lab/autonomous-farm/'}>Try the {journey.kind==='farm'?'software-factory':'autonomous-farm'} story</a><p class="experience-limit">The scenes illustrate selected decisions using a small teaching model. They do not simulate a real {journey.kind==='farm'?'farm, animal or robot':'engineering organization or production service'}, certify a design or grant execution authority. The engineering notes retain the research and full limits.</p><a href={`${journey.path}sources/`}>Sources and publication record</a></section>
  {legacyHeadings.filter(h=>!ids.has(h.slug)&&!['read-all','story-complete','main'].includes(h.slug)).map(h=><p class="experience-legacy" id={h.slug}><a href={`${journey.notes}#${journey.kind==='farm'?(farmLegacy[h.slug]||'architecture'):h.slug}`}>{h.text} is now in the engineering notes. Open this section.</a></p>)}
</div>
<script is:inline type="module" src={runtimeUrl}></script>
