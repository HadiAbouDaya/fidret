---
import type {WorkspaceState} from '../lib/lab-workspaces';
interface Props {kind:'farm'|'factory';scene:string;state:WorkspaceState}
const {kind,scene,state}=Astro.props;
const v=state.values;
const factoryNodes:Record<string,{key:string;label:string;note:string}[]>={
  evidence:[{key:'candidate',label:'Proposed candidate',note:'The bytes for release'},{key:'proof',label:'Evidence covers',note:'Identity and result are separate'},{key:'grant',label:'Execution boundary',note:'Checked when acting'}],
  receipt:[{key:'receipt',label:'Operation release-13',note:'Illustrative stable reference'},{key:'observation',label:'Customer journey',note:'Booking and reminder behavior'},{key:'recovery',label:'Recovery position',note:'Needed before promotion'}],
  observe:[{key:'receipt',label:'Limited rollout',note:'A receipt establishes deployment'},{key:'observation',label:'Customer evidence',note:'Sample and window must qualify'},{key:'recovery',label:'Recovery position',note:'Part of the release policy'}],
  authority:[{key:'grant',label:'Execution grant',note:'Current at execution'},{key:'review',label:'Change boundary',note:'Routine or designated exception'},{key:'checks',label:'Exact artifact',note:'Green checks do not widen scope'}],
  recovery:[{key:'observation',label:'Customer promise',note:'Watch the actual outcome'},{key:'recovery',label:'Recovery position',note:'Affects available options'},{key:'receipt',label:'Deployment receipt',note:'Separate from an already-sent message'}],
};
---
<figure class:list={['workspace-artifact',`workspace-artifact--${kind}`]}>
 {kind==='farm'?<div class="farm-world">
   <svg viewBox="0 0 640 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
     <path class="world-land" d="m26 120 312-83 279 79-37 148-274 28L26 238Z"/>
     <path class="world-field" d="m369 80 183 53-33 90-177-48Z"/><path class="world-furrows" d="m386 94-26 74m56-65-25 74m56-65-24 74m55-65-23 74m53-65-20 68"/>
     <path class="world-water" d="M70 157c0-30 88-30 88 0v46c0 30-88 30-88 0Z"/><ellipse class="world-water-top" cx="114" cy="157" rx="44" ry="17"/>
     <path class="world-pipe" d="M158 182h87l84-27h27"/>
     <path class="world-care-pipe" d="M114 220v37h290"/><rect class="world-controller" x="247" y="143" width="57" height="49" rx="5"/><path class="world-check" d="m260 165 11 11 21-22"/><path class="world-stop" d="m262 154 27 26m0-26-27 26"/>
     <path class="world-barn" d="m404 225 62-31 81 28v50l-78 19-65-23Z"/><path class="world-roof" d="m393 225 74-44 91 37-89 27Z"/><path class="world-door" d="m431 244 26 7v30l-26-8Z"/>
     <path class="world-cloud" d="M219 38c-5-25 30-35 46-17 16-11 39 0 35 18 27 9 18 33-5 33h-70c-30 0-30-28-6-34Z"/><path class="world-link" d="M260 74v68"/>
   </svg>
   <div class="world-label world-label--cloud" data-artifact-node="grant"><span>Cloud proposal</span><strong data-artifact-value="grant">{v.grant}</strong><span data-artifact-value="cloud">{v.cloud}</span></div>
   <div class="world-label world-label--field" data-artifact-node="field"><span>Field</span><strong data-artifact-value="field">{v.field}</strong></div>
   <div class="world-label world-label--water" data-artifact-node="water"><span>Shared water</span><strong data-artifact-value="water">{v.water}</strong></div>
   <div class="world-label world-label--local" data-artifact-node={scene==='receipt'?'effect':'local'}><span>Local controller</span><strong data-artifact-value={scene==='receipt'?'effect':'local'}>{scene==='receipt'?v.effect:v.local}</strong></div>
   <div class="world-label world-label--care" data-artifact-node="care"><span>Animal care</span><strong data-artifact-value="care">{v.care}</strong></div>
 </div>:<div class:list={['factory-artifact',`factory-artifact--${scene}`]}>
   {factoryNodes[scene]!.map((node,i)=><div class="factory-object" data-artifact-node={node.key}><span>{node.label}</span><strong data-artifact-value={node.key}>{v[node.key]}</strong><p>{scene==='evidence'&&i===1?<span data-artifact-value="checks">{v.checks}</span>:node.note}</p>{i<2&&<span class="factory-connection" data-match-symbol={scene==='evidence'&&i===0?'true':undefined} aria-hidden="true">{scene==='evidence'&&i===0?'≠':'→'}</span>}</div>)}
 </div>}
 <figcaption><strong class="artifact-boundary">Decision boundary: <span data-artifact-value="boundary">{v.boundary}</span></strong>{kind==='farm'?'Conceptual layout. The highlighted controller governs this proposal; essential care has its own local plan.':'Illustrative release record. These objects describe evidence and boundaries, not a running deployment.'}</figcaption>
</figure>
