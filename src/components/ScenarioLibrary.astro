---
import {farmDomains,farmScenarios,assessFarm,farmDecisionLabels} from '../lib/autonomous-farm';
import {releaseCases,assessRelease,decisionLabels} from '../lib/software-factory';
import {farmJourney,factoryJourney} from '../lib/lab-journeys';
import runtimeUrl from '../scripts/lab-experience.js?url&no-inline';
import '../styles/lab-experience.css';
interface Props {kind:'farm'|'factory'}
const {kind}=Astro.props;
const journey=kind==='farm'?farmJourney:factoryJourney;
const domains=kind==='farm'?farmDomains:[{key:'release',name:'Release and recovery'}];
const items=kind==='farm'?farmScenarios.map(s=>({...s,answer:farmDecisionLabels[assessFarm(s.facts).decision]})):releaseCases.map(s=>({key:s.key,domain:'release',label:s.label,title:s.title,observations:[...s.evidence],proposal:'Decide the next rollout or recovery action.',lesson:s.lesson,consequence:'The illustrated policy applies only to the recorded candidate and conditions.',person:'The responsible engineering, release and service owners.',nextEvidence:assessRelease(s.facts).reasons.join(' '),deep:'',answer:decisionLabels[assessRelease(s.facts).decision]}));
---
<div class="scenario-library" data-topic-finder data-find-noun="situations">
  <header class="reference-heading"><a class="text-link" href={journey.path}>Back to the workspace</a><h1>{kind==='farm'?'Find a farm situation.':'Find a release situation.'}</h1><p>Go straight to the boundary you need. Open a situation for the evidence, response and responsible people.</p><nav class="reference-routes" aria-label="Lab reading routes"><a href={journey.path}>Decision workspace</a><a href={journey.notes}>Engineering notes</a><a href={journey.brief} download>Operating brief</a></nav><p class="experience-scope">Fictional teaching cases. No real system is connected and no action is authorized here.</p></header>
  <div class="reference-finder" data-only-enhanced hidden><label for="situation-search">Find a situation</label><div class="reference-search-row"><input id="situation-search" type="search" placeholder={kind==='farm'?'Try milk, water, offline or receipt':'Try evidence, timeout or recovery'} autocomplete="off" /><button type="button" data-clear>Clear</button></div><div class="reference-filters" role="group" aria-label="Situation categories"><button type="button" data-filter="all" aria-pressed="true">All situations</button>{kind==='farm'&&domains.map(d=><button type="button" data-filter={d.key} aria-pressed="false">{d.name}</button>)}</div><div aria-live="polite" aria-atomic="true" data-find-status>{items.length} situations shown</div></div>
  <p class="reference-empty" data-find-empty hidden>No matching situation. Try a shorter term or <button type="button" data-clear>show all situations</button>.</p>
  <div class="reference-situations">{items.map(s=><details class="reference-situation" id={`case-${s.key}`} data-find-item data-group={s.domain}><summary><span class="reference-domain">{domains.find(d=>d.key===s.domain)?.name}</span><span class="reference-title">{s.title}</span><span class="reference-situation-label">{s.label}</span></summary><div class="reference-situation-body"><h2>What is known</h2><ul>{s.observations.map(e=><li>{e}</li>)}</ul><p><strong>The proposed action:</strong> {s.proposal}</p><h2>{s.answer}</h2><p>{s.lesson}</p><p>{s.consequence}</p><dl><div><dt>Who responds</dt><dd>{s.person}</dd></div><div><dt>Evidence to look for next</dt><dd>{s.nextEvidence}</dd></div></dl><div class="reference-routes"><a href={kind==='farm'?`${journey.notes}#${s.deep}`:journey.notes}>Read the engineering boundary</a><a href={`#case-${s.key}`}>Link to this situation</a></div></div></details>)}</div>
  <footer class="reference-ending"><a class="button" href={journey.path}>Explore the workspace</a><a class="text-link" href={`${journey.path}sources/`}>Sources and publication notes</a></footer>
</div>
<script is:inline type="module" src={runtimeUrl}></script>
