---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {searchGraph,serializeGraph,socialPreview,type ArticleMetadata} from '../lib/seo';
import '../styles/styles.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogDescription?: string;
  variant?: 'home' | 'lab' | 'minimal';
  noindex?: boolean;
  article?: ArticleMetadata;
}

const {
  title, description, canonical, ogDescription = description,
  variant = 'home', noindex = false, article,
} = Astro.props;
const preview = canonical ? socialPreview(canonical) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F6F2E9" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {variant !== 'minimal' && (
      <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    )}
    {canonical && (
      <>
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Fidret" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={preview!.url} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={preview!.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={preview!.url} />
        {article && <><meta property="article:published_time" content={article.published} /><meta property="article:modified_time" content={article.updated} /></>}
        <link rel="describedby" href="/llms.txt" type="text/plain" />
        {!noindex && description && <script is:inline type="application/ld+json" set:html={serializeGraph(searchGraph(canonical,title,description,article))} />}
      </>
    )}
    <slot name="head" />
  </head>
  <body class:list={{ 'lab-page': variant === 'lab' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader variant={variant} />
    <slot />
    {variant !== 'minimal' && <SiteFooter />}
  </body>
</html>
