---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogDescription?: string;
  variant?: 'home' | 'lab' | 'minimal';
  noindex?: boolean;
}

const {
  title, description, canonical, ogDescription = description,
  variant = 'home', noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F6F2E9" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {variant !== 'minimal' && (
      <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    )}
    <link rel="stylesheet" href="/styles.css" />
    {variant === 'lab' && <link rel="stylesheet" href="/lab.css" />}
    {canonical && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Fidret" />
      </>
    )}
  </head>
  <body class:list={{ 'lab-page': variant === 'lab' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader variant={variant} />
    <slot />
    {variant !== 'minimal' && <SiteFooter />}
  </body>
</html>
